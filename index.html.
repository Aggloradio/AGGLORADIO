<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AGGLORADIO - En direct</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg,#101426,#202c48);
  color: white;
  text-align: center;
}

header {
  padding: 35px 15px;
  background: #080d19;
}

header h1 {
  color: #ffca28;
  font-size: 42px;
  letter-spacing: 4px;
  margin: 0;
}

header p { color: #bbb; }

main { padding: 45px 15px; }

.player {
  max-width: 480px;
  margin: 25px auto;
  padding: 30px 20px;
  background: #26344e;
  border-radius: 20px;
  box-shadow: 0 8px 30px #0006;
}

.onair {
  color: #ff5555;
  font-weight: bold;
  letter-spacing: 2px;
}

.play {
  display: inline-block;
  background: #ffca28;
  color: #101426;
  border: none;
  border-radius: 30px;
  padding: 15px 35px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  margin: 15px;
}

.play:hover { background: white; }

audio { width: 100%; }

#status {
  color: #ccc;
  font-size: 14px;
}

footer {
  padding: 25px;
  background: #080d19;
  color: #aaa;
}
</style>
</head>

<body>

<header>
  <h1>AGGLORADIO</h1>
  <p>La radio qui vous accompagne partout !</p>
</header>

<main>
  <h2>Bienvenue sur AGGLORADIO</h2>
  <p>Retrouvez votre radio sur internet, où que vous soyez.</p>

  <div class="player">
    <p class="onair">● AGGLORADIO EN DIRECT</p>
    <h2>ÉCOUTEZ-NOUS !</h2>

    <button class="play" id="playButton">
      ▶ ÉCOUTER EN DIRECT
    </button>

    <audio id="radio" controls preload="none">
      <source src="http://82.145.41.8:20916/;" type="audio/mpeg">
      Votre navigateur ne prend pas en charge ce lecteur.
    </audio>

    <p id="status">Prêt à écouter AGGLORADIO</p>
  </div>
</main>

<footer>
  © 2026 AGGLORADIO - Tous droits réservés
</footer>

<script>
const radio = document.getElementById("radio");
const button = document.getElementById("playButton");
const status = document.getElementById("status");

button.addEventListener("click", async () => {
  if (radio.paused) {
    status.textContent = "Connexion à la radio...";
    try {
      await radio.play();
      button.textContent = "❚❚ PAUSE";
      status.textContent = "Lecture en cours";
    } catch (error) {
      status.textContent =
        "Impossible de démarrer. Vérifiez le flux radio.";
    }
  } else {
    radio.pause();
    button.textContent = "▶ ÉCOUTER EN DIRECT";
    status.textContent = "Lecture en pause";
  }
});

radio.addEventListener("playing", () => {
  status.textContent = "Vous écoutez AGGLORADIO !";
});

radio.addEventListener("error", () => {
  status.textContent = "Erreur de connexion au flux radio.";
});
</script>

</body>
</html>
